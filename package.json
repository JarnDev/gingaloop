{
  "name": "gingaloop",
  "version": "0.2.0",
  "description": "Daily coding challenges generated by Claude, in any language, with sandboxed tests, earned levels and locked solutions.",
  "type": "module",
  "bin": {
    "ginga": "bin/ginga.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "prompts/",
    "profiles/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check:examples": "node bin/ginga.mjs validate --examples"
  },
  "keywords": [
    "coding-challenges",
    "kata",
    "practice",
    "claude",
    "cli",
    "daily"
  ],
  "author": "JarnDev",
  "license": "MIT"
}
